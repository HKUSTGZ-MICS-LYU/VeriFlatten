[options]
mode prove
depth 10

[engines]
smtbmc

[script]
read -formal mpeg_golden.v
prep -top main
design -stash golden

read -formal f_mpeg.v
prep -top main
design -stash revised

design -load golden
design -copy-from revised -as revised main
miter -equiv -flatten -make_outputs main revised miter
clk2fflogic
prep -top miter

[files]
mpeg_golden.v
f_mpeg.v
