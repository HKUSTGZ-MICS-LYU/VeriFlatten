set_mismatch_message_filter -warn FMR_ELAB-147
set_mismatch_message_filter -warn FMR_VLOG-038
set hdlin_error_on_mismatch_message false
set verification_failing_point_limit 0
set verification_ignore_unmatched_implementation_blackbox_input true
set verification_match_undriven_signals false
set verification_verify_unread_bbox_inputs false
set verification_passing_mode consistency


read_sverilog -r -17 rocket.v
set_top RocketTile

read_sverilog -i -17 f_rocket.v
set_top RocketTile

verify -restart
exit